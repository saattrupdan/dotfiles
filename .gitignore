# VIm swap files
**/*.swp

# MacOS
.DS_Store

# Environment variables
**/.env

# Compiled Python
**/__pycache__/

# Cache files
**/.ruff_cache/
# zsh compiled scripts — regenerable, and zsh picks them up by side effect
**/*.zwc

# Node
**/node_modules/

# Pi agent memories — stored at ~/.pi/agent/memories (outside this repo by
# design), but ignored here as a safety net in case anyone ever drops a copy
# into the tree. Memories may contain private/local notes — keep them out.
**/memories/
agentic/pi/memories/
.pi/agent/memories/

# Python build artifacts
**/*.egg-info/
**/build/

# Pi agent secrets — contain API keys and credentials
agentic/pi/models.json
agentic/pi/auth.json

# Pi agent
.pi/
